# --- Shopify ---
# Custom app Admin API access token (Settings > Apps > Develop apps).
# Needs read_products scope at minimum.
SHOPIFY_STORE_DOMAIN=your-shopify-domain.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=your-shopify-admin-api-access-token
SHOPIFY_API_VERSION=2026-01

# --- Medusa ---
# Base URL of your Medusa v2 server (no trailing slash).
MEDUSA_BACKEND_URL=http://localhost:9000
# Either provide an admin API token directly...
MEDUSA_API_TOKEN=
# ...or an admin email/password so the sync can authenticate and get a JWT.
MEDUSA_ADMIN_EMAIL=[EMAIL_ADDRESS]
MEDUSA_ADMIN_PASSWORD=secret

# The Medusa stock location to write inventory quantities into.
# If left blank, the sync uses the first stock location returned by the API.
MEDUSA_STOCK_LOCATION_ID=

# The Medusa sales channel new products should be attached to.
# If left blank, products are created without an explicit sales channel
# and Medusa will apply its default.
MEDUSA_SALES_CHANNEL_ID=

# Currency used when reading Shopify variant prices (must be enabled in Medusa's region/store).
DEFAULT_CURRENCY_CODE=usd
